# Copy this file to ".env" and adjust values for your environment.
# Do NOT commit the real ".env" file to version control.

# Database connection (works for local and hosted MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=campus_db
# Optional: DB port (most providers use 3306)
# DB_PORT=3306

# Application port (hosting providers usually inject PORT automatically)
PORT=3001

# Session secret (MUST be a strong random string in production)
SESSION_SECRET=replace_with_random_string

# Node environment: "production" on hosted platforms, "development" locally
NODE_ENV=development

# CORS: allowed origins for the frontend (comma-separated list).
# Example for local dev: http://localhost:3000
# Example for production: https://your-frontend-domain.com
CORS_ORIGIN=http://localhost:3000

# Allow admin signup via /register (use with caution in production)
ALLOW_ADMIN_SIGNUP=false

# OAuth (Google) - optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# OTP (email) - optional
OTP_DEV_ECHO=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=no-reply@campus-hub.local

